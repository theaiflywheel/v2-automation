        "\n",
        "from textblob import TextBlob\n",
        "\n",
        "# 2. Analyze the headline we just caught\n",
        "analysis = TextBlob(headline)\n",
        "score = analysis.sentiment.polarity # This gives a number between -1 and 1\n",
        "\n",
        "# 3. Logic to decide the mood\n",
        "if score > 0:\n",
        "    mood = \"🚀 POSITIVE (Bullish)\"\n",
        "elif score < 0:\n",
        "    mood = \"📉 NEGATIVE (Bearish)\"\n",
        "else:\n",
