        "    elif score < 0:\n",
        "        mood = \"❌ BEARISH\"\n",
        "    else:\n",
        "        mood = \"⚖️ NEUTRAL\"\n",
        "\n",
        "    print(f\"News: {h}\")\n",
        "    print(f\"AI Verdict: {mood} (Score: {score})\\n\")"
