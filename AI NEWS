        "import requests\n",
        "from bs4 import BeautifulSoup\n",
        "\n",
        "# 1. Pick a target\n",
        "url = \"https://www.theverge.com/\"\n",
        "# We add a 'User-Agent' so the website thinks we are a real browser\n",
        "headers = {'User-Agent': 'Mozilla/5.0'}\n",
        "\n",
        "response = requests.get(url, headers=headers)\n",
        "soup = BeautifulSoup(response.text, 'html.parser')\n",
        "\n",
        "# 2. Try to find the headline safely\n",
        "# We look for 'h2' OR 'a' tags (common for headlines)\n",
        "headline_element = soup.find('h2') or soup.find('a')\n",
        "\n",
        "if headline_element:\n",
        "    headline = headline_element.get_text().strip()\n",
        "    print(f\"Latest Tech News: {headline}\")\n",
        "else:\n",
        "    print(\"Could not find a headline. The website might be blocking us or changed its layout!\")"
      ],
      "metadata": {
