        "def send_market_alert(news, sentiment, score):\n",
        "    # In a real startup, this function would send a message to Discord or Email\n",
        "    print(\"🔔 --- NEW MARKET SIGNAL DETECTED --- 🔔\")\n",
        "    print(f\"SIGNAL: {sentiment}\")\n",
        "    print(f\"STRENGTH: {abs(score) * 100:.1f}%\")\n",
        "    print(f\"SOURCE: {news}\")\n",
        "    print(\"------------------------------------------\")\n",
        "\n",
        "# Trigger the alert ONLY if the news is significant\n",
        "# Billionaires don't waste time on \"Neutral\" news.\n",
        "for h in headlines:\n",
        "    analysis = TextBlob(h)\n",
        "    score = analysis.sentiment.polarity\n",
        "\n",
        "    if abs(score) > 0.3: # Only alert if the news is strongly positive or negative\n",
        "        mood = \"🚀 ACTIONABLE POSITIVE\" if score > 0 else \"⚠️ ACTIONABLE NEGATIVE\"\n",
        "        send_market_alert(h, mood, score)\n",
        "    else:\n",
        "        print(f\"Skipping neutral news: {h[:30]}...\")"
